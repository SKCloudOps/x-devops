# Gmail Configuration for Daily Reports
# Follow the setup instructions below to get these values

# Your Gmail address (sender)
GMAIL_SENDER_EMAIL=your-email@gmail.com

# Gmail App-Specific Password
# Get this from: https://myaccount.google.com/apppasswords
# Requirements:
# 1. Enable 2-factor authentication on your Google account
# 2. Generate an app password for "Mail" and "Windows Computer"
# 3. Copy the 16-character password below (remove spaces)
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Recipient email address (optional, defaults to sathishkrcs@gmail.com)
GMAIL_RECIPIENT_EMAIL=sathishkrcs@gmail.com
